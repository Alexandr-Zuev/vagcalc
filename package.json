{
  "name": "vagcalc",
  "version": "1.0.0",
  "description": "Railway Weighbridge Platform Calculator",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:test && node --test verify/",
    "build:test": "esbuild src/utils/solver.ts --bundle --format=esm --outfile=verify/solver.mjs --log-level=error && esbuild src/utils/geometry.ts --bundle --format=esm --outfile=verify/geometry.mjs --log-level=error && esbuild src/data/presets.ts --bundle --format=esm --outfile=verify/presets.mjs --log-level=error",
    "preview": "vite preview"
  },
  "keywords": [
    "railway",
    "weighbridge",
    "calculator",
    "platform",
    "weight",
    "train",
    "wagons"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.2",
    "typescript": "^7.0.2",
    "vite": "^4.3.9"
  }
}
